DATABASE_URL=sqlite:///./dev.db
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Cloudinary: host photo uploads (signed by the API; the secret never reaches the browser).
# Leave blank to disable uploads; hosts can still paste photo links.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Turso (production database). Used only when DATABASE_URL starts with libsql://
# TURSO_AUTH_TOKEN is read separately and never goes inside the URL.
# TURSO_AUTH_TOKEN=
#
# For your own machine only: scripts/on_turso.py reads these four to run a command against
# the named database (see the README). The deployed app does not use them.
# TURSO_DATABASE_URL_TESTING=libsql://...
# TURSO_TESTING_SECRET=
# TURSO_DATABASE_URL_PRODUCTION=libsql://...
# TURSO_PRODUCTION_SECRET=
