# Production: an absolute path on the persistent disk, e.g. DATABASE_URL=sqlite:////var/data/app.db
DATABASE_URL=sqlite:///./dev.db
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Cloudinary: host photo uploads (signed by the API; the secret never reaches the browser).
# Leave blank to disable uploads; hosts can still paste photo links.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
